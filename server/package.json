{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend API - Hexagonal Architecture - Payment App",
  "main": "dist/interfaces/http/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/interfaces/http/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node -r tsconfig-paths/register dist/interfaces/http/server.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "migration:run": "npm run typeorm -- migration:run -d src/infrastructure/database/AppDataSource.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/infrastructure/database/AppDataSource.ts",
    "seed": "ts-node -r tsconfig-paths/register src/infrastructure/database/seed.ts"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.3.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
